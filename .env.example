# Stowave Frontend Environment Variables Example

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# Live Backend URL
NEXT_PUBLIC_BACKEND_URL=https://teamstowaveb.vercel.app

# Optional Database direct connection (if running migrations/scripts)
# DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-pooler.supabase.com:6543/postgres
